# Server
NODE_ENV=development
PORT=8000

# MongoDB connection string
# Local:      mongodb://localhost:27017/dev-tinder
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/dev-tinder

# JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=86400

# Frontend origin for CORS (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000
